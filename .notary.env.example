# Copy to .notary.env (gitignored) only if you need env-based tooling.
# Store notary credentials in Keychain (never commit passwords to files):
#   xcrun notarytool store-credentials DataGateMacNotary --apple-id YOUR_APPLE_ID --team-id YOUR_TEAM_ID
NOTARY_PROFILE=DataGateMacNotary
APPLE_ID=your-apple-id@example.com
TEAM_ID=YOUR_TEAM_ID
